    spoonfeeder.inputs[1] = 0x50; // F & I
    spoonfeeder.Run("f|fvvvvvv");
    spoonfeeder.PrintLog();
} */

void SpoonDemo() {
    //SAY('a');
    // JustSpy("first");
    spoonfeeder.Run("vvvvvvvv|vvvvvvvvvvvvvvvvvvvv");
    spoonfeeder.PrintLog("NMI");

    spoonfeeder.inputs[0] = 0xC6; // LDD #....
    spoonfeeder.inputs[1] = 0x5B;
    spoonfeeder.inputs[2] = 0x5D;
    spoonfeeder.inputs[3] = 0xFD; // STD ....
    spoonfeeder.inputs[4] = 0x05;
    spoonfeeder.inputs[5] = 0x00;
    spoonfeeder.Run("vvvffffff|vvvvvvvvvvvvvvvvvvvv");
    spoonfeeder.PrintLog("stored 5B5D at 0500");

    spoonfeeder.inputs[0] = 0xC6; // LDD #....
    spoonfeeder.inputs[1] = 0x36;
    spoonfeeder.inputs[2] = 0x37;
    spoonfeeder.inputs[3] = 0xFD; // STD ....
    spoonfeeder.inputs[4] = 0x05;
    spoonfeeder.inputs[5] = 0x10;
    spoonfeeder.Run("vvvffffff|vvvvvvvvvvvvvvvvvvvv");
    spoonfeeder.PrintLog("stored 3637 at 0510");

#if 0
    //JustSpy("second (expect IRQ)");
    //JustSpy("third");
    SendSWI("SWI");
    JustSpy("middle");
    SendRTI("RTI");
    JustSpy("after");
#endif
    spoonfeeder.Run("$");

    while (1) {
        SET_LED(1);
        sleep_ms(500);
        SET_LED(0);
        sleep_ms(500);
    }
}

} // namespace
#endif // CENTIPEDE_FIRMWARE_PIO_SPOONFEED_H_
